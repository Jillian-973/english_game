# Copy this file to .env and fill in the values (never commit .env).

# MongoDB Atlas connection string (Free cluster, dedicated user with access to this database only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name
MONGODB_DB=devot

# Local port for `npm run dev`
PORT=3000
